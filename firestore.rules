rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function valid(d) {
      return d.keys().hasOnly(['target','name','text','createdAt','label','uid','editedAt'])
        && d.target is string && d.target.size() <= 40
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && (!('label' in d) || (d.label is string && d.label.size() <= 120));
    }
    match /boards/{board}/comments/{id} {
      allow read: if true;
      // Tạo mới: ai cũng được; nếu kèm uid thì phải đúng uid của người đang gửi (đăng nhập ẩn danh)
      allow create: if valid(request.resource.data)
        && request.resource.data.createdAt == request.time
        && !('editedAt' in request.resource.data)
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      // Sửa: chỉ người viết, chỉ đổi nội dung
      allow update: if request.auth != null && resource.data.get('uid', '') == request.auth.uid
        && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
        && request.resource.data.editedAt == request.time;
      // Xóa: chỉ người viết (chủ board xóa được mọi góp ý trong Firebase Console)
      allow delete: if request.auth != null && resource.data.get('uid', '') == request.auth.uid;
    }
  }
}
